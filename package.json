{
  "name": "dreamreader",
  "version": "0.1.0",
  "description": "Local-first desktop ebook reader with PT-BR focused audio generation.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tts-models": "node scripts/smoke-test-local-tts-models.mjs",
    "setup:python-tts": "node scripts/setup-python-tts.mjs",
    "download:tts-models": "node scripts/download-local-tts-models.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@tailwindcss/vite": "^4.1.17",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "electron-updater": "^6.6.2",
    "fast-xml-parser": "^5.3.2",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "marked": "^17.0.1",
    "music-metadata": "^11.13.0",
    "node-llama-cpp": "^3.18.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.7",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  },
  "build": {
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
